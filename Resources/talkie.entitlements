<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required so the Hardened Runtime (mandatory for notarization) still
         allows microphone capture. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Required so the Hardened Runtime still allows read-only Calendar access
         (the opt-in meeting-context feature). Used strictly read-only; this is a
         local-data entitlement, not a network one. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
