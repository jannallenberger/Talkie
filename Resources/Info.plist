<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.coralate.talkie</string>
    <key>CFBundleName</key>
    <string>Talkie</string>
    <key>CFBundleDisplayName</key>
    <string>Talkie</string>
    <key>CFBundleExecutable</key>
    <string>Talkie</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>de</string>
        <string>fr</string>
        <string>es</string>
        <string>it</string>
        <string>pt-BR</string>
        <string>nl</string>
        <string>ja</string>
        <string>ko</string>
        <string>zh-Hans</string>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>26.0</string>
    <!-- Talkie's public repository base URL. Read at runtime by Brand.repoURL and
         used only to hand a "report a bug" link to the user's browser (never
         fetched in-process). Config, not a user setting; kept out of Swift source
         so the on-device core carries no https:// literal (check-no-network.sh). -->
    <key>TalkieRepoURL</key>
    <string>https://github.com/jannallenberger/Talkie</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>ATSApplicationFontsPath</key>
    <string>Fonts</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Talkie listens to your microphone while you hold the dictation key, so it can turn your speech into text.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>During meeting recording, Talkie captures your Mac's audio so it can transcribe the other participants. Audio stays on your Mac.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Talkie uses on-device speech recognition to transcribe what you say. Audio stays on your Mac.</string>
    <key>NSInputMonitoringUsageDescription</key>
    <string>Talkie watches for your dictation key so you can start talking from any app.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Talkie pauses Music or Spotify while you dictate so your speech isn't drowned out, then resumes playback when you're done.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Talkie reads the event you're in to title a meeting recording and spell attendee names right. It never creates, edits, or deletes anything, and your calendar data stays on your Mac.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>Talkie reads the event you're in to title a meeting recording and spell attendee names right. It never creates, edits, or deletes anything, and your calendar data stays on your Mac.</string>
    <!-- .talkiepack: a shareable one-file dictionary (vocabulary + replacement rules).
         We own the type, so we EXPORT the UTI (conforming to public.json since the file
         is JSON) and register a document type so double-clicking one opens Talkie and
         routes to the Dictionary import preview. Kept in sync with
         TalkiePack.utTypeIdentifier / .fileExtension. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.coralate.talkie.talkiepack</string>
            <key>UTTypeDescription</key>
            <string>Talkie dictionary</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>talkiepack</string>
                </array>
                <key>public.mime-type</key>
                <array>
                    <string>application/json</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Talkie dictionary</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.coralate.talkie.talkiepack</string>
            </array>
        </dict>
    </array>
    <!-- macOS Services (D7). Two right-click / Services-menu actions handled by
         ServicesProvider.swift (NSApp.servicesProvider), registered at launch with
         NSUpdateDynamicServices(). NSMessage is the selector's BASE name — AppKit
         appends `:userData:error:`, so `transcribeFiles` → transcribeFiles:userData:error:
         and `cleanupText` → cleanupText:userData:error:. NSRequiredContext is empty so
         both are offered everywhere. These appear in other apps' Services menus once
         LaunchServices re-registers the bundle (scripts/run.sh runs `lsregister -f`;
         a logout or `killall pboard` may be needed once on a dev machine). -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Transcribe with Talkie</string>
            </dict>
            <key>NSMessage</key>
            <string>transcribeFiles</string>
            <key>NSPortName</key>
            <string>Talkie</string>
            <!-- File action: operate on audio + video files selected in Finder. -->
            <key>NSSendFileTypes</key>
            <array>
                <string>public.audio</string>
                <string>public.movie</string>
            </array>
            <key>NSRequiredContext</key>
            <dict/>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Clean up with Talkie</string>
            </dict>
            <key>NSMessage</key>
            <string>cleanupText</string>
            <key>NSPortName</key>
            <string>Talkie</string>
            <!-- Text action: read the selected string, return the cleaned string so
                 the host app replaces the selection in place. -->
            <key>NSSendTypes</key>
            <array>
                <string>NSStringPboardType</string>
            </array>
            <key>NSReturnTypes</key>
            <array>
                <string>NSStringPboardType</string>
            </array>
            <key>NSRequiredContext</key>
            <dict/>
        </dict>
    </array>
</dict>
</plist>
